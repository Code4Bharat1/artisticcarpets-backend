{
  "info": {
    "name": "Artistic Carpets — Full API",
    "description": "Complete Postman collection for the Artistic Carpets backend. Base: http://localhost:5000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL",      "value": "http://localhost:5000" },
    { "key": "API",           "value": "{{BASE_URL}}/api" },
    { "key": "ADMIN_TOKEN",   "value": "" },
    { "key": "USER_TOKEN",    "value": "" },
    { "key": "PRODUCT_ID",    "value": "" },
    { "key": "PRODUCT_SLUG",  "value": "" },
    { "key": "ORDER_ID",      "value": "" },
    { "key": "USER_ID",       "value": "" },
    { "key": "CATEGORY_ID",   "value": "" },
    { "key": "COLLECTION_ID", "value": "" },
    { "key": "COUPON_ID",     "value": "" },
    { "key": "REVIEW_ID",     "value": "" }
  ],
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Admin Auth",
          "item": [
            {
              "name": "Register Admin",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"name\": \"Super Admin\",\n  \"email\": \"admin@artisticcarpets.com\",\n  \"phoneNumber\": \"+919876543210\",\n  \"password\": \"Admin@123\"\n}"
                },
                "url": { "raw": "{{API}}/auth/admin/register", "host": ["{{API}}"], "path": ["auth","admin","register"] }
              }
            },
            {
              "name": "Login Admin (by Email)",
              "event": [{ "listen": "test", "script": { "exec": [
                "const r = pm.response.json();",
                "if (r.token) pm.collectionVariables.set('ADMIN_TOKEN', r.token);"
              ], "type": "text/javascript" }}],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"identifier\": \"admin@artisticcarpets.com\",\n  \"password\": \"Admin@123\"\n}"
                },
                "url": { "raw": "{{API}}/auth/admin/login", "host": ["{{API}}"], "path": ["auth","admin","login"] },
                "description": "identifier = email OR phone. Token auto-saved to ADMIN_TOKEN."
              }
            },
            {
              "name": "Login Admin (by Phone)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"identifier\": \"+919876543210\",\n  \"password\": \"Admin@123\"\n}"
                },
                "url": { "raw": "{{API}}/auth/admin/login", "host": ["{{API}}"], "path": ["auth","admin","login"] }
              }
            },
            {
              "name": "Logout Admin",
              "request": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
                "url": { "raw": "{{API}}/auth/admin/logout", "host": ["{{API}}"], "path": ["auth","admin","logout"] }
              }
            }
          ]
        },
        {
          "name": "User Auth",
          "item": [
            {
              "name": "Register User",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phoneNumber\": \"+919876543211\",\n  \"password\": \"User@123\"\n}"
                },
                "url": { "raw": "{{API}}/auth/user/register", "host": ["{{API}}"], "path": ["auth","user","register"] }
              }
            },
            {
              "name": "Login User (by Email)",
              "event": [{ "listen": "test", "script": { "exec": [
                "const r = pm.response.json();",
                "if (r.token) pm.collectionVariables.set('USER_TOKEN', r.token);"
              ], "type": "text/javascript" }}],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"identifier\": \"john@example.com\",\n  \"password\": \"User@123\"\n}"
                },
                "url": { "raw": "{{API}}/auth/user/login", "host": ["{{API}}"], "path": ["auth","user","login"] },
                "description": "identifier = email OR phone. Token auto-saved to USER_TOKEN."
              }
            },
            {
              "name": "Login User (by Phone)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"identifier\": \"+919876543211\",\n  \"password\": \"User@123\"\n}"
                },
                "url": { "raw": "{{API}}/auth/user/login", "host": ["{{API}}"], "path": ["auth","user","login"] }
              }
            },
            {
              "name": "Logout User",
              "request": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }],
                "url": { "raw": "{{API}}/auth/user/logout", "host": ["{{API}}"], "path": ["auth","user","logout"] }
              }
            }
          ]
        },
        {
          "name": "Shared Auth",
          "item": [
            {
              "name": "Refresh Token",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"token\": \"{{USER_TOKEN}}\"\n}"
                },
                "url": { "raw": "{{API}}/auth/refresh-token", "host": ["{{API}}"], "path": ["auth","refresh-token"] }
              }
            },
            {
              "name": "Change Password",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
                ],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"oldPassword\": \"User@123\",\n  \"newPassword\": \"NewUser@456\"\n}"
                },
                "url": { "raw": "{{API}}/auth/change-password", "host": ["{{API}}"], "path": ["auth","change-password"] }
              }
            },
            {
              "name": "Forgot Password",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"email\": \"john@example.com\"\n}"
                },
                "url": { "raw": "{{API}}/auth/forgot-password", "host": ["{{API}}"], "path": ["auth","forgot-password"] }
              }
            },
            {
              "name": "Reset Password",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "options": { "raw": { "language": "json" } },
                  "raw": "{\n  \"email\": \"john@example.com\",\n  \"resetToken\": \"123456\",\n  \"newPassword\": \"NewUser@789\"\n}"
                },
                "url": { "raw": "{{API}}/auth/reset-password", "host": ["{{API}}"], "path": ["auth","reset-password"] }
              }
            }
          ]
        }
      ]
    },

    {
      "name": "👤 Users",
      "item": [
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }],
            "body": { "mode": "formdata", "formdata": [
              { "key": "firstName", "value": "John",          "type": "text" },
              { "key": "lastName",  "value": "Doe",           "type": "text" },
              { "key": "phone",     "value": "+919876543211", "type": "text" },
              { "key": "avatar",    "type": "file",           "src": [] }
            ]},
            "url": { "raw": "{{API}}/users/profile", "host": ["{{API}}"], "path": ["users","profile"] },
            "description": "PUT /api/users/profile — multipart/form-data. avatar field is optional."
          }
        },
        {
          "name": "Get Wishlist",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }],
            "url": { "raw": "{{API}}/users/wishlist", "host": ["{{API}}"], "path": ["users","wishlist"] }
          }
        },
        {
          "name": "Toggle Wishlist Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }],
            "url": { "raw": "{{API}}/users/wishlist/{{PRODUCT_ID}}", "host": ["{{API}}"], "path": ["users","wishlist","{{PRODUCT_ID}}"] }
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"label\": \"Home\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+919876543211\",\n  \"addressLine1\": \"12 MG Road\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"postalCode\": \"400001\",\n  \"country\": \"India\",\n  \"isDefault\": true\n}"
            },
            "url": { "raw": "{{API}}/users/addresses", "host": ["{{API}}"], "path": ["users","addresses"] }
          }
        },
        {
          "name": "Update Address",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"city\": \"Delhi\",\n  \"isDefault\": false\n}"
            },
            "url": { "raw": "{{API}}/users/addresses/ADDRESS_ID_HERE", "host": ["{{API}}"], "path": ["users","addresses","ADDRESS_ID_HERE"] }
          }
        },
        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }],
            "url": { "raw": "{{API}}/users/addresses/ADDRESS_ID_HERE", "host": ["{{API}}"], "path": ["users","addresses","ADDRESS_ID_HERE"] }
          }
        },
        {
          "name": "[Admin] List All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": {
              "raw": "{{API}}/users?page=1&limit=20",
              "host": ["{{API}}"], "path": ["users"],
              "query": [
                { "key": "page", "value": "1" }, { "key": "limit", "value": "20" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "[Admin] Get User Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{API}}/users/stats", "host": ["{{API}}"], "path": ["users","stats"] }
          }
        },
        {
          "name": "[Admin] Get User By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{API}}/users/{{USER_ID}}", "host": ["{{API}}"], "path": ["users","{{USER_ID}}"] }
          }
        },
        {
          "name": "[Admin] Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"isVIP\": true,\n  \"loyaltyPoints\": 500,\n  \"loyaltyTier\": \"Gold\",\n  \"adminNotes\": \"VIP customer\"\n}"
            },
            "url": { "raw": "{{API}}/users/{{USER_ID}}", "host": ["{{API}}"], "path": ["users","{{USER_ID}}"] },
            "description": "Requires role: super_admin, admin, or manager."
          }
        },
        {
          "name": "[Admin] Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{API}}/users/{{USER_ID}}", "host": ["{{API}}"], "path": ["users","{{USER_ID}}"] },
            "description": "Requires role: super_admin only."
          }
        }
      ]
    },

    {
      "name": "🛋️ Products",
      "item": [
        {
          "name": "Get All Products (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{API}}/products?page=1&limit=12",
              "host": ["{{API}}"], "path": ["products"],
              "query": [
                { "key": "page",       "value": "1" },
                { "key": "limit",      "value": "12" },
                { "key": "search",     "value": "", "disabled": true },
                { "key": "category",   "value": "", "disabled": true },
                { "key": "collection", "value": "", "disabled": true },
                { "key": "material",   "value": "", "disabled": true },
                { "key": "minPrice",   "value": "", "disabled": true },
                { "key": "maxPrice",   "value": "", "disabled": true },
                { "key": "inStock",    "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Product By Slug (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{API}}/products/slug/{{PRODUCT_SLUG}}", "host": ["{{API}}"], "path": ["products","slug","{{PRODUCT_SLUG}}"] }
          }
        },
        {
          "name": "[Admin] Get Product Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{API}}/products/stats", "host": ["{{API}}"], "path": ["products","stats"] }
          }
        },
        {
          "name": "[Admin] Get Product By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{API}}/products/{{PRODUCT_ID}}", "host": ["{{API}}"], "path": ["products","{{PRODUCT_ID}}"] }
          }
        },
        {
          "name": "[Admin] Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "body": { "mode": "formdata", "formdata": [
              { "key": "title",            "value": "Persian Hand-Knotted Carpet", "type": "text" },
              { "key": "shortDescription", "value": "Luxurious hand-knotted rug.", "type": "text" },
              { "key": "description",      "value": "Crafted by artisans in Kashmir.", "type": "text" },
              { "key": "category",         "value": "CATEGORY_ID_HERE",             "type": "text" },
              { "key": "price",            "value": "25000",                         "type": "text" },
              { "key": "discountPrice",    "value": "21000",                         "type": "text" },
              { "key": "stock",            "value": "15",                            "type": "text" },
              { "key": "isFeatured",       "value": "true",                          "type": "text" },
              { "key": "thumbnail",        "type": "file", "src": [] },
              { "key": "images",           "type": "file", "src": [] },
              { "key": "images",           "type": "file", "src": [] }
            ]},
            "url": { "raw": "{{API}}/products", "host": ["{{API}}"], "path": ["products"] }
          }
        },
        {
          "name": "[Admin] Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "body": { "mode": "formdata", "formdata": [
              { "key": "price",      "value": "23000", "type": "text" },
              { "key": "stock",      "value": "20",    "type": "text" },
              { "key": "isFeatured", "value": "true",  "type": "text" }
            ]},
            "url": { "raw": "{{API}}/products/{{PRODUCT_ID}}", "host": ["{{API}}"], "path": ["products","{{PRODUCT_ID}}"] }
          }
        },
        {
          "name": "[Admin] Archive Product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{API}}/products/{{PRODUCT_ID}}/archive", "host": ["{{API}}"], "path": ["products","{{PRODUCT_ID}}","archive"] }
          }
        },
        {
          "name": "[Admin] Restore Product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{API}}/products/{{PRODUCT_ID}}/restore", "host": ["{{API}}"], "path": ["products","{{PRODUCT_ID}}","restore"] }
          }
        },
        {
          "name": "[Admin] Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }],
            "url": { "raw": "{{API}}/products/{{PRODUCT_ID}}", "host": ["{{API}}"], "path": ["products","{{PRODUCT_ID}}"] }
          }
        },
        {
          "name": "[Admin] Bulk Action",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"ids\": [\"ID1\", \"ID2\"],\n  \"action\": \"feature\"\n}"
            },
            "url": { "raw": "{{API}}/products/bulk", "host": ["{{API}}"], "path": ["products","bulk"] }
          }
        },
        {
          "name": "[Admin] Delete Product Image",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"imageUrl\": \"http://localhost:5000/uploads/products/filename.jpg\"\n}"
            },
            "url": { "raw": "{{API}}/products/{{PRODUCT_ID}}/images", "host": ["{{API}}"], "path": ["products","{{PRODUCT_ID}}","images"] }
          }
        }
      ]
    },

